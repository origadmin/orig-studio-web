# ============================================================
# PACKAGE MANAGER LOCK FILES
# ============================================================
# This project uses BUN as its package manager.
# bun.lock / bun.lockb are the CORRECT lock files and MUST be kept.
# All other package manager lock files are FORBIDDEN (competing lock files
# created by npm/yarn/pnpm when developers accidentally run wrong commands).
package-lock.json
yarn.lock
pnpm-lock.yaml
pnpm-workspace.yaml

# Style backups
.style-backups/

# ============================================================
# FORBIDDEN BUILD TOOLS
# ============================================================
# Vite is STRICTLY FORBIDDEN in this project.
# This project uses Rsbuild as its frontend build tool.
# Any vite config or dependency must be rejected immediately.
vite.config.*
vitest.config.*
vite-env.d.ts

# ============================================================
# GO FILES - FRONTEND PROJECT BOUNDARY
# ============================================================
# This is a frontend (React/Rsbuild/Bun) project.
# The ONLY Go files allowed are embed.go and embed_dev.go,
# which exist solely to expose the compiled dist/ via Go's embed.FS
# to the backend. All other Go files (SPA handlers, server logic, etc.)
# MUST live in the backend Go project, NOT in this frontend submodule.
*.go
!embed.go
!embed_dev.go

# ============================================================
# CLEANUP QUARANTINE + PREVENTION (added 2026-08-11)
# ============================================================
# Quarantine dir for moved-out junk (never commit)
tmp/

# Playwright user-data-dir browser profiles (NEVER commit Chromium caches)
# Root cause of repo bloat: playwright userDataDir set to relative 'admin'/'anon'
# Anchor admin/ to repo root so it only matches the Playwright profile dir,
# NOT the real source dirs src/components/admin and src/pages/admin.
/admin/
anon/
user-data/
playwright-profiles/

# one-off probe / debug scripts
probe_*.cjs
probe_*.mjs
*subcount*.cjs
scripts/*-debug.cjs

# one-off bug probe scripts must NOT live at web/ root (BUG-213).
# They were migrated from web/ root into web/tests/bugs/ on 2026-08-13.
# Keep them on disk for reference only; never commit.
bug[0-9][0-9][0-9]-*.cjs

# probes migrated from web/ root into web/tests/bugs/ (BUG-213).
# tests/bugs/ also holds committed regression specs (B087..B101), so only
# ignore the loose *.cjs probe class, not the whole directory.
tests/bugs/*.cjs
tests/bugs/bug190-visual/
