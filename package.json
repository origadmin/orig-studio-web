{
  "name": "@origstudio/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "dev:mock": "rsbuild dev --config rsbuild.config.mock.ts",
    "build": "rsbuild build",
    "build:mock": "rsbuild build --config rsbuild.config.mock.ts",
    "preview": "rsbuild preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "style-lint": "bun run scripts/style-lint.ts",
    "style-lint:strict": "bun run scripts/style-lint.ts --strict",
    "style-backup": "bun run scripts/style-backup.ts",
    "style-backup:create": "bun run scripts/style-backup.ts create",
    "style-backup:restore": "bun run scripts/style-backup.ts restore",
    "style-backup:list": "bun run scripts/style-backup.ts list",
    "style-backup:compare": "bun run scripts/style-backup.ts compare",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "check": "bun run lint && bun run typecheck && bun run style-lint",
    "generate:routes": "tsr generate",
    "generate:types": "openapi-typescript ../resources/api-docs/openapi/openapi.yaml -o src/types/api.d.ts"
  },
